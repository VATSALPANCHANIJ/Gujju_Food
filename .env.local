# ============================================================================
# GUJJU FOOD HUB — Table Booking environment variables
# Copy to .env.local for dev, and set the same in Vercel → Project → Settings.
# Nothing here is needed for the marketing site; only the booking BACKEND uses it.
# ============================================================================

# --- Public site URL (used to build manage-booking links in emails) ---
NEXT_PUBLIC_SITE_URL=https://gujju-food.vercel.app

# --- Booking preview mode ---
# While the backend is not connected, the form completes locally so the UI is
# reviewable. Set to "false" once Supabase/Resend/Turnstile are live to force
# real API responses only.
NEXT_PUBLIC_BOOKING_DEMO=false
# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://ottgucbwdpoccfiouusa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KScDor7t-DOZX9YJH7OuIA_Xnspa0ic   # Public, safe to expose
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sLvtZcbJVwH3WwzfENrvBw_EE-pDuUf   # SERVER ONLY — never expose

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
BOOKING_FROM_EMAIL="Gujju Food Hub <reservations@your-domain.com>"
BOOKING_OWNER_EMAIL=owner@your-domain.com

# --- Cloudflare Turnstile (bot protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADr_a0EiFDH8hNuC
TURNSTILE_SECRET_KEY=0x4AAAAAADr_a3NnQqotxEWyCmvzHzQvfHI

